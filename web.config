<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- App-level Python settings -->
  <appSettings>
    <!-- WSGI entry point -->
    <add key="WSGI_HANDLER" value="app.server" />

    <!-- Ensure helper files are importable -->
    <add key="PYTHONPATH" value="D:\home\site\wwwroot" />

    <!-- Flask production mode -->
    <add key="FLASK_ENV" value="production" />
  </appSettings>
  <system.webServer>

    <!-- Python FastCGI Handler -->
    <handlers>
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="D:\Python311\python.exe|D:\Python311\Scripts\wfastcgi.py"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!-- Route all requests to Flask app -->
    <rewrite>
      <rules>
        <rule name="FlaskRouting" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.py" />
        </rule>
      </rules>
    </rewrite>

    <!-- Allow file uploads (CSV / Excel) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

  </system.webServer>

</configuration>
